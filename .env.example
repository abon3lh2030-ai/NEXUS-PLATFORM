# ============================================================
# NEXUS Platform — environment variables (placeholders only, NO real secrets)
# Copy to `.env` for local development. See ENV_SETUP.md (Arabic) for every variable.
# ============================================================

# ---------- Runtime ----------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# ---------- Supabase (Database / Auth / Storage / Realtime) ----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY — never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- URLs ----------
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# ---------- AI provider ----------
# anthropic (production) | mock (development/tests only — refused in production)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-opus-5
AI_EFFORT=medium
USD_TO_SAR_RATE=3.75

# ---------- AI virtual computers ----------
# storage_workspace = isolated files/documents workspace (no browser/terminal)
# e2b = external sandbox (browser + terminal) — not connected yet
COMPUTER_PROVIDER=storage_workspace
E2B_API_KEY=

# ---------- Payments (Moyasar — Apple Pay + cards) ----------
MOYASAR_PUBLISHABLE_KEY=pk_test_xxx
MOYASAR_SECRET_KEY=sk_test_xxx
MOYASAR_WEBHOOK_SECRET=
MOYASAR_APPLE_PAY_ENABLED=false

# ---------- Email (platform notifications + AI employee mail) ----------
# resend | console (development only — does not send)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="NEXUS <no-reply@your-domain.sa>"
# Domain verified with the email provider, used for AI employee addresses (e.g. atlas.1a2b3c@agents.your-domain.sa)
EMAIL_AGENT_DOMAIN=
# Shared secret the inbound-email relay sends in the X-Nexus-Webhook-Secret header
INBOUND_EMAIL_WEBHOOK_SECRET=

# ---------- Calendar ----------
# nexus = built-in calendar. google / microsoft = external sync via OAuth (not connected yet)
CALENDAR_PROVIDER=nexus
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ---------- Meetings (AI attendance) ----------
# nexus = scheduling/notes/processing only. recall = Recall.ai meeting bots (Zoom / Meet / Teams)
MEETING_PROVIDER=nexus
RECALL_API_KEY=
RECALL_REGION=us-east-1
RECALL_WEBHOOK_SECRET=

# ---------- Voice ----------
# none | elevenlabs
VOICE_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# ---------- Platform ----------
PLATFORM_ADMIN_NOTIFICATION_EMAIL=abdullahfah2030@hotmail.com
PLATFORM_COMMERCIAL_REGISTRATION=7055047331
MALWARE_SCAN_PROVIDER=none

# ---------- Background workers ----------
AGENT_WORKER_ENABLED=true
AGENT_WORKER_CONCURRENCY=2
AGENT_POLL_INTERVAL_MS=2000
CRON_ENABLED=true

# ---------- Web app (Vite — PUBLIC values only; bundled into the browser) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_API_BASE_URL=http://localhost:8080
VITE_PUBLIC_APP_URL=http://localhost:5173

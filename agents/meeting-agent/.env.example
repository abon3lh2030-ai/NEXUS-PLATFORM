# ── LiveKit (Cloud now; a self-hosted LiveKit server later — same variables) ──
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=nexus-meeting-agent

# ── NEXUS API (the agent calls /internal/meeting-agent/* with this shared secret) ──
NEXUS_API_URL=https://api.your-domain.sa
MEETING_AGENT_TOKEN=

# ── Speech providers: elevenlabs | local ──
STT_PROVIDER=elevenlabs
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# NEXUS's own voice server (Whisper / NAMAA). If it doesn't answer within 5 s, ElevenLabs is used and logged.
LOCAL_VOICE_URL=
LOCAL_VOICE_KEY=
